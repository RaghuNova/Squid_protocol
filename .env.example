# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
# Local Docker Postgres URL:
DATABASE_URL=postgresql://squid_user:squid_secret@localhost:5432/squid_protocol?schema=public
# Dedicated Test Database URL (Never use production for testing):
TEST_DATABASE_URL=postgresql://squid_user:squid_secret@localhost:5432/squid_protocol_test?schema=public
# Explicit safety flag for test-data reset:
TEST_RESET_ENABLED=false
# Local testing game restart button in admin dashboard (development only):
ENABLE_TEST_GAME_RESET=true

# Authentication & Security
SESSION_SECRET=dev-squid-protocol-secret-key-replace-in-production-min32chars
JWT_SECRET=dev-squid-protocol-jwt-secret-key-replace-in-production-min32chars
COOKIE_SECURE=false

# CORS & Client
FRONTEND_URL=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
