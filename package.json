{
  "name": "squid-protocol",
  "version": "1.0.0",
  "private": true,
  "description": "SQUID PROTOCOL — SURVIVE THE SYSTEM",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "build": "npm run build:backend && npm run build:frontend",
    "test:backend": "npm run test --workspace=backend",
    "test:frontend": "npm run test --workspace=frontend",
    "test": "npm run test:backend && npm run test:frontend",
    "typecheck": "npm run typecheck --workspace=backend && npm run typecheck --workspace=frontend",
    "db:migrate": "npm run prisma:migrate --workspace=backend",
    "db:deploy": "npm run prisma:deploy --workspace=backend",
    "db:seed": "npm run db:seed --workspace=backend",
    "db:reset:test": "npm run db:reset:test --workspace=backend"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "prisma@5.22.0": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}
