generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  VOLUNTEER
  TEAM
}

enum RoundStatus {
  UPCOMING
  ACTIVE
  PAUSED
  ENDED
}

enum SignalState {
  GREEN
  RED
}

enum SubmissionStatus {
  CORRECT
  INCORRECT
  PENALIZED
  REJECTED
}

model User {
  id           String    @id @default(uuid())
  username     String    @unique
  passwordHash String
  role         UserRole  @default(TEAM)
  teamId       String?   @unique
  team         Team?     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([role])
}

model Team {
  id                     String    @id @default(uuid())
  teamCode               String    @unique
  name                   String
  members                String    @default("") // Comma-separated names or details
  currentRound           Int       @default(1)
  currentStage           Int       @default(1)
  totalScore             Int       @default(0)
  isDisqualified         Boolean   @default(false)
  finalBreachCompletedAt DateTime?
  finalBreachPosition    Int?      // Verified 1st, 2nd, 3rd... finishing order
  finalBreachPoints      Int?      // Points awarded based on finishing position
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user                   User?
  physicalVerification   PhysicalVerification?
  accessToken            AccessToken?
  submissions            Submission[]
  scoreEvents            ScoreEvent[]

  @@index([totalScore(sort: Desc)])
}

model WinnerAnnouncement {
  id                       Int       @id @default(1)
  isFinalized              Boolean   @default(false)
  finalizedAt              DateTime?
  finalizedByAdminId       String?
  finalizedByAdminUsername String?
  winners                  Json?     // [{ rank: 1, teamId, teamCode, name, totalScore, r1Score, r2Score, r3Score, r3Position, r3Points, completedAt }]
  notes                    String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
}

model RoundControl {
  id                   Int         @id // 1, 2, 3
  title                String
  status               RoundStatus @default(UPCOMING)
  startTime            DateTime?
  endTime              DateTime?
  pausedAt             DateTime?
  remainingSeconds     Int?
  durationMinutes      Int         @default(15)
  signalState          SignalState @default(GREEN)
  redLightPenaltyMode  Boolean     @default(false) // false: reject, true: -50 penalty
  doublePointsEnabled  Boolean     @default(false)
  updatedAt            DateTime    @updatedAt
}

model Question {
  id             String       @id @default(uuid())
  round          Int          @default(1)
  orderIndex     Int          @unique
  topic          String
  prompt         String
  codeSnippet    String?
  options        Json         // [{ id: "A", text: "..." }, ...]
  correctOption  String       // "A", "B", "C", or "D"
  explanation    String
  pointsNormal   Int          @default(100)
  pointsDouble   Int          @default(200)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  submissions    Submission[]

  @@index([orderIndex])
}

model SudokuPuzzle {
  id                    String   @id @default(uuid())
  round                 Int      @default(2)
  initialGrid           String   // 36 characters representing 6x6 grid ('0' for empty, 'S','T','C','U','A','D')
  solutionGrid          String   // 36 characters complete valid solution
  hintDeductionPercent  Int      @default(25)
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model BrokenLogicPuzzle {
  id              String   @id @default(uuid())
  round           Int      @default(2)
  title           String
  scenario        String
  codeSnippet     String
  expectedOutput  String   // Normalized server-validated output
  points          Int      @default(200)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model PhysicalVerification {
  id               String   @id @default(uuid())
  teamId           String   @unique
  team             Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  verifiedByUserId String
  verifiedByName   String
  verifiedAt       DateTime @default(now())
  notes            String?
}

model AccessToken {
  id          String    @id @default(uuid())
  teamId      String?   @unique
  team        Team?     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  tokenCode   String    @unique
  isRedeemed  Boolean   @default(false)
  redeemedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([tokenCode])
}

model DebugChallenge {
  id               String   @id @default(uuid())
  title            String
  description      String
  intendedBehavior String
  javaCode         String
  pythonCode       String
  cCode            String
  inputData        String
  derivationRule   String
  expectedFinalKey String
  points           Int      @default(200)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Submission {
  id                    String           @id @default(uuid())
  teamId                String
  team                  Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  round                 Int
  stage                 Int              @default(1)
  questionId            String?
  question              Question?        @relation(fields: [questionId], references: [id], onDelete: SetNull)
  submittedValue        String
  doublePointsSelected  Boolean          @default(false)
  signalAtSubmission    SignalState      @default(GREEN)
  status                SubmissionStatus
  pointsAwarded         Int              @default(0)
  clientIp              String?
  createdAt             DateTime         @default(now())

  @@index([teamId, round])
  @@index([createdAt])
}

model ScoreEvent {
  id                String   @id @default(uuid())
  teamId            String
  team              Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  round             Int
  stage             Int      @default(1)
  source            String   // e.g. "ROUND1_Q_1", "ROUND2_SUDOKU", "ROUND2_BROKEN_LOGIC", "ROUND3_CUP", "ROUND3_ACCESS_QR", "ROUND3_DEBUG_FINAL", "ADMIN_ADJUSTMENT_<id>"
  pointsDelta       Int
  reason            String
  createdByAdminId  String?
  createdAt         DateTime @default(now())

  @@unique([teamId, source])
  @@index([teamId])
}

model AdminAuditLog {
  id            String   @id @default(uuid())
  adminUserId   String
  adminUsername String
  action        String
  targetType    String
  targetId      String?
  details       Json?
  ipAddress     String?
  createdAt     DateTime @default(now())

  @@index([createdAt])
}

model AppSettings {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
